+#ifdef LMI_INPUT_TRACE
+typedef struct __IOHIDEvent *LMIHIDEventRef;
+extern uint32_t IOHIDEventGetType(LMIHIDEventRef event);
+extern uint64_t IOHIDEventGetTimeStamp(LMIHIDEventRef event);
+extern uint64_t IOHIDEventGetSenderID(LMIHIDEventRef event);
+static void (*input_enqueue_original)(id, SEL, LMIHIDEventRef);
+static void (*input_handle_original)(id, SEL, LMIHIDEventRef);
+static unsigned input_enqueue_count, input_handle_count;
+
+static void
+input_uikit_line(const char *stage, unsigned *count, LMIHIDEventRef event)
+{
+	if (event == NULL || IOHIDEventGetType(event) != 11) {
+		return;
+	}
+	unsigned n = __sync_add_and_fetch(count, 1);
+	if (n <= 192) {
+		say("LMI_UIKIT_INPUT stage=%s n=%u posted_us=%llu observed_us=%llu sender=%llu\n", stage, n,
+		    IOHIDEventGetTimeStamp(event) * timebase.numer / timebase.denom / 1000,
+		    now_us(), IOHIDEventGetSenderID(event));
+	}
+}
+
+static void
+input_enqueue(id self, SEL cmd, LMIHIDEventRef event)
+{
+	input_uikit_line("enqueue", &input_enqueue_count, event);
+	input_enqueue_original(self, cmd, event);
+}
+
+static void
+input_handle(id self, SEL cmd, LMIHIDEventRef event)
+{
+	input_uikit_line("handle", &input_handle_count, event);
+	input_handle_original(self, cmd, event);
+}
+
+/* Optional observation at the recipient, always forwarding to the resolved
+ * original implementation. Refuse any selector whose runtime ABI differs from
+ * void(id, SEL, IOHIDEventRef); no events are created, changed or suppressed. */
+static void
+input_uikit_watch(void)
+{
+	Class cls = objc_getClass("UIApplication");
+	const char *names[] = { "_enqueueHIDEvent:", "_handleHIDEvent:" };
+	IMP wrappers[] = { (IMP)input_enqueue, (IMP)input_handle };
+	for (unsigned i = 0; i < 2; i++) {
+		Method method = cls ? class_getInstanceMethod(cls, sel_registerName(names[i])) : NULL;
+		char *result = method ? method_copyReturnType(method) : NULL;
+		char *argument = method && method_getNumberOfArguments(method) == 3 ? method_copyArgumentType(method, 2) : NULL;
+		bool valid = result && strcmp(result, "v") == 0 && argument && argument[0] == '^' &&
+		    strstr(argument, "__IOHIDEvent") != NULL;
+		free(result);
+		free(argument);
+		if (!valid) {
+			say("LMI_UIKIT_INPUT_HOOK selector=%s unavailable_or_abi_mismatch\n", names[i]);
+			continue;
+		}
+		IMP original = method_getImplementation(method);
+		if (i == 0) input_enqueue_original = (void (*)(id, SEL, LMIHIDEventRef))original;
+		else input_handle_original = (void (*)(id, SEL, LMIHIDEventRef))original;
+		method_setImplementation(method, wrappers[i]);
+		say("LMI_UIKIT_INPUT_HOOK selector=%s observing_original=%p\n", names[i], original);
+	}
+}
+#endif
+
