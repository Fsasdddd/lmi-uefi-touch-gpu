+			CFRelease(description);
+		}
+		for (size_t pos = 0; pos < strlen(text); pos += 160) {
+			say("LMI_BK_STATE n=%u part=%zu state=%p %.160s\n", n, pos / 160, state, text + pos);
+		}
+	}
